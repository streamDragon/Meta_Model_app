  "diagnosis_rules": [
    {
      "id": "too_many_hard",
      "label": "יותר מדי אילוצים קשיחים בו-זמנית",
      "description": "כשיותר משלושה תנאים מוגדרים כקשיחים וחשובים מאוד, אף פתרון לא יכול לעמוד בכולם יחד.",
      "advice": "בחר 1-2 תנאים שהם באמת לא נתונים למשא ומתן, ושחרר את השאר לגמישות חלקית."
    },
    {
      "id": "unclear_hierarchy",
      "label": "היררכיית ערכים לא ברורה",
      "description": "הרבה תנאים מקבלים חשיבות גבוהה זהה, ואין הכרעה מי מנצח בהתנגשות.",
      "advice": "דרג: אם היו מתנגשים שניים מהם מחר בבוקר - מי מנצח? קבע מנצח לכל זוג מתנגש."
    },
    {
      "id": "hidden_identity",
      "label": "סוגיית זהות סמויה",
      "description": "תנאי שממוקם ברמת זהות או ייעוד ומוגדר קשיח - כנראה הדיון אינו על התוצאה אלא על מי אתה.",
      "advice": "הפרד בין \"מי אני\" לבין \"מה אני עושה הפעם\". נסה ניסוי ברמת התנהגות בלי לאיים על הזהות."
    },
    {
      "id": "missing_resource",
      "label": "חסרה אסטרטגיה או משאב",
      "description": "יש פחדים, מחירים או אילוצים - אבל אין אף כרטיס של משאב או אסטרטגיה שפותר אותם.",
      "advice": "הוסף כרטיס משאב: איזה ידע, זמן, כסף, אדם או דרך פעולה היו ממוססים את ההתנגשות?"
    },
    {
      "id": "value_conflict",
      "label": "קונפליקט ערכים לא פתור",
      "description": "שני ערכים חשובים מאוד מושכים לכיוונים מנוגדים ואף אחד לא הוכרע כמנצח.",
      "advice": "אל תבחר ביניהם - חפש קודם אסטרטגיית שילוב. אם אין, הכרע מי מנצח בשלב הנוכחי בלבד."
    },
    {
      "id": "all_or_nothing",
      "label": "חשיבת הכל-או-כלום",
      "description": "המינימום והאידיאל זהים - אין מרחב בין \"מושלם\" ל\"כישלון\".",
      "advice": "הגדר גרסת 70%: מה יהיה מספיק טוב לעכשיו גם אם זה לא האידיאל?"
    },
    {
      "id": "over_compromise",
      "label": "ויתור יתר / דרישת חסר",
      "description": "תנאים שחשובים לך מאוד מסומנים כגמישים בלי מינימום מוגדר - אתה עלול להסתפק בפחות מדי.",
      "advice": "לתנאי חשוב חייב להיות רף מינימום מוגדר. כתוב מהו הקו האדום שמתחתיו זו כבר פשרה מוגזמת."
    }
  ],
